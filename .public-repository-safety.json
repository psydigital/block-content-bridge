{
  "schema_version": 1,
  "repository": "psydigital/block-content-bridge",
  "public_refs": { "branches": ["refs/heads/main"], "tag_patterns": ["^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$"] },
  "public_identities": { "email_patterns": ["^hello@psydigital\\.co\\.uk$"] },
  "path_exceptions": [],
  "synthetic_exceptions": [],
  "ci": { "workflow": ".github/workflows/public-repository-safety.yml", "check": "Public repository safety" },
  "protection": {
    "branches": ["main"], "tag_patterns": ["v*"],
    "require_pull_request": true, "require_current_branch": true,
    "require_conversation_resolution": true, "deny_force_push": true, "deny_deletion": true
  },
  "manual_documents": ["README.md", "docs/testing.md", "LICENSE"],
  "tools": { "gitleaks": "8.30.1" }
}
